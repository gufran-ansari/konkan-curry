Options -Indexes
RewriteEngine On

# Force trailing slash on all URLs (except actual files and PHP scripts)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteCond %{REQUEST_URI} !\.(php)$ [NC]
RewriteRule ^(.*)$ $1/ [R=301,L]

# Remove .html extension and redirect to trailing slash
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1/ [R=301,L]

# Internally serve the .html file when URL with trailing slash is requested
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ $1.html [L]
